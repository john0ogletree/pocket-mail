# Global settings
$(local_domains) = example.com
$(hostname) = mx.example.com

# ----------------------------------------------------------------------------
# SMTP Engine (Local-first direct handling)
# ----------------------------------------------------------------------------

smtp tcp://127.0.0.1:2525 {
    limits {
        all rate 20 1m
    }

    # Direct delivery rules
    source $(local_domains) {
        destination postmaster $(local_domains) {
            deliver_to &local_mail
        }
        default {
            deliver_to &direct_remote
        }
    }

    default {
        reject 550 5.7.1 "Relay denied"
    }
}

# ----------------------------------------------------------------------------
# Local Storage (Zero external database dependency)
# ----------------------------------------------------------------------------

imap tcp://127.0.0.1:1143 {
    auth pass_table identity_db

    storage {
        driver sqlite3
        dsn /path/to/storage/maddy.db
    }
}
